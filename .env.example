# Production: isi lewat dashboard Vercel / shell, JANGAN commit.
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
CRON_SECRET=ganti-dengan-secret-cron-acak

# Kredensial awal saat seed database kosong (4-64 karakter tanpa spasi).
SEED_ADMIN_PIN=ubah-sandi-admin-yang-kuat
SEED_DEMO_PIN=demo123
SEED_CASHIER_PIN=123456
SEED_KITCHEN_PIN=2222

# Origin tambahan untuk API mobile (dipisah koma bila perlu).
# MOBILE_ORIGIN=https://localhost
# Hanya untuk LAN HTTP tepercaya; biarkan kosong untuk HTTPS.
# COOKIE_SECURE=0
