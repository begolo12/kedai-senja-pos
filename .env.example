# Production: isi lewat dashboard Vercel / shell, JANGAN commit.
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# PIN awal saat seed database kosong (4–8 digit).
SEED_ADMIN_PIN=ubah-pin-manajemen
SEED_CASHIER_PIN=ubah-pin-kasir

# Origin tambahan untuk API mobile (dipisah koma bila perlu).
# MOBILE_ORIGIN=https://localhost
# Hanya untuk LAN HTTP tepercaya; biarkan kosong untuk HTTPS.
# COOKIE_SECURE=0
